{
  "name": "supertag-cli",
  "version": "2.2.3",
  "description": "CLI for Tana integration - query, create, sync, and manage Tana workspaces with semantic search",
  "type": "module",
  "bin": {
    "supertag": "./supertag"
  },
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile=supertag",
    "build:lite": "bun build src/cli-lite.ts --compile --outfile=supertag-lite",
    "build:mcp": "bun build src/mcp/index.ts --compile --outfile=supertag-mcp",
    "build:export": "bun build src/cli/tana-export.ts --compile --outfile=supertag-export --external=playwright --external=playwright-core --external=chromium-bidi --external=electron",
    "dev": "bun run src/index.ts",
    "dev:mcp": "bun run src/mcp/index.ts",
    "inspect:mcp": "npx @modelcontextprotocol/inspector bun run src/mcp/index.ts",
    "test": "bun test ./tests/*.test.ts ./tests/codegen/ ./tests/commands/ ./tests/config/ ./tests/db/ ./tests/e2e/ ./tests/embeddings/ ./tests/integration/ ./tests/mcp/ ./tests/services/ ./tests/types/ ./tests/unit/ ./tests/utils/ ./tests/visualization/ ./src/**/*.test.ts",
    "test:slow": "bun test ./tests/slow/",
    "test:full": "bun test --bail",
    "typecheck": "tsc --noEmit",
    "precommit": "bun run test:full"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "commander": "^14.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastest-levenshtein": "^1.0.16",
    "fastify": "^5.8.4",
    "resona": "github:jcfischer/resona#main",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "playwright": "^1.58.2",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "tana",
    "knowledge-management",
    "cli",
    "typescript",
    "bun",
    "sqlite",
    "mcp",
    "semantic-search"
  ],
  "author": "Jens-Christian Fischer <jens-christian@invisible.ch>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcfischer/supertag-cli.git"
  },
  "bugs": {
    "url": "https://github.com/jcfischer/supertag-cli/issues"
  },
  "homepage": "https://github.com/jcfischer/supertag-cli#readme"
}
